# Скопируйте в .env на Pi и заполните значения.
# Генерация ключей:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Ключ приложения: открывает только POST /v1/auth/login.
# Он же кладётся в local.properties как NEIRO_PUSH_API_KEY.
API_KEY=replace-me
# ПАРОЛЬ ОТ ДАШБОРДА https://push.neiro.greemlab.ru/dashboard — это значение
# целиком вставляется в поле «ключ» на странице входа. Он же нужен для /health
# и /v1/admin/* (заголовком Authorization: Bearer …).
# Посмотреть рабочий:
#   ssh roster-pi-remote "grep ^ADMIN_API_KEY= ~/neiro-push/.env"
ADMIN_API_KEY=replace-me
# Fernet: шифрование user_token в БД
TOKEN_ENCRYPTION_KEY=replace-me

# YClients. Единственное место, где теперь живёт партнёрский токен: в APK его
# больше нет, в базе — тоже. Значение берётся из local.properties на Mac и
# ставится руками; деплой падает, если оно пустое.
YCLIENTS_PARTNER_TOKEN=
# Филиал по умолчанию при входе — телефон его больше не знает
YCLIENTS_COMPANY_ID=

# Интервал опроса YClients днём (до 23:00), секунды
POLL_INTERVAL_SECONDS=10

# Интервал опроса ночью (после 23:00), секунды
POLL_NIGHT_INTERVAL_SECONDS=3600
QUIET_START_HOUR=23

# Firebase Cloud Messaging (HTTP v1)
# Положите service account JSON в secrets/fcm-service-account.json
FCM_CREDENTIALS_PATH=/secrets/fcm-service-account.json
FCM_PROJECT_ID=

DATABASE_PATH=/data/neiro_push.db
LOG_LEVEL=info
