<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Базовая тема приложения. windowBackground = цвет, который мгновенно показывается
        системой пока процесс ещё не нарисовал ни одного кадра — это убирает «чёрный экран» старта.
    -->
    <style name="Theme.Neiro.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        Splash-тема через AndroidX SplashScreen API. На API 31+ используется системный сплеш,
        на старых API библиотека эмулирует его. Это самый быстрый способ дать пользователю
        первый кадр с фирменным фоном до того, как Compose отрисует UI.
    -->
    <style name="Theme.Neiro" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Neiro.Base</item>
    </style>

</resources>
