<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Буква N сделана еще компактнее для соответствия современным стандартам иконок.
      Она занимает центральную область, гарантируя отсутствие обрезки на любых устройствах.
    -->

    <!-- Тень -->
    <path
        android:pathData="M44,40 L44,70 M44,42 L64,68 L64,40"
        android:strokeColor="#15000000"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Основная буква N -->
    <path
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M44,38 L44,68 M44,38 L64,68 L64,38">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="38"
                android:endX="54"
                android:endY="68"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#F5F5F5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Блик -->
    <path
        android:pathData="M44,38 L44,46 M44,38 L50,46"
        android:strokeColor="#30FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

</vector>
