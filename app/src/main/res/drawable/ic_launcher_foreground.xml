<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Синий круг r=32 (диаметр 64). При наложении на белый
        ic_launcher_background по бокам остаётся белая кайма (Telegram-style).
        3-точечный градиент добавляет мягкий объём, не меняя стиль.
    -->
    <path android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#2DB1E5" />
                <item android:offset="0.55" android:color="#1F97CA" />
                <item android:offset="1.0" android:color="#1789B6" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
        Мягкий блик сверху ("стеклянная" грань).
        Эллипс полностью внутри круга — ничего не выходит за границу,
        никаких артефактов на тёмном фоне.
        К низу плавно становится прозрачным, поэтому не наезжает на букву.
    -->
    <path android:pathData="M54,34m-18,0a18,10 0,1 1,36 0a18,10 0,1 1,-36 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="41"
                android:type="linear">
                <item android:offset="0.0" android:color="#42FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Тень под буквой N (даёт лёгкий объём) -->
    <path
        android:pathData="M46,43 L46,67 M46,45 L62,65 L62,43"
        android:strokeColor="#1A000000"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Белая буква N -->
    <path
        android:pathData="M46,41 L46,65 M46,41 L62,65 L62,41"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
